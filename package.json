{
  "name": "sonya-c.github.io",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "bundle exec jekyll serve --trace",
    "start:livereload": "bundle exec jekyll serve --livereload",
    "start:detached": "bundle exec jekyll serve --detach",
    "build": "bundle exec jekyll build",
    "pa11y:home": "pa11y-ci http://127.0.0.1:4000",
    "pa11y:sitemap": "pa11y-ci --sitemap http://127.0.0.1:4000/sitemap.xml --sitemap-find https://accessibility.civicactions.com --sitemap-replace http://127.0.0.1:4000 --sitemap-exclude \"/*.pdf\"",
    "lint:sass": "stylelint \"_sass/**/*.scss\"",
    "lint:sass:fix": "stylelint \"_sass/**/*.scss\" --fix",
    "lighthouse:view": "lighthouse http://127.0.0.1:4000 --view --output-path=./lighthouse-results.html"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@shopify/prettier-plugin-liquid": "^1.11.0",
    "lighthouse": "^12.8.2",
    "pa11y-ci": "^4.1.1",
    "prettier": "^3.9.8",
    "stylelint": "^17.15.0",
    "stylelint-config-standard-scss": "^17.0.0"
  }
}
